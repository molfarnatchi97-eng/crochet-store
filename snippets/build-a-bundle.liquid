{% comment %}
  Build-a-Bundle Component
  Allows users to select exactly 6 digital products from a grid to add as a bundle.
{% endcomment %}

{%- assign active_collection = bundle_collection -%}
{%- if active_collection != blank and active_collection.products == blank -%}
  {%- assign active_collection = collections[bundle_collection] -%}
{%- endif -%}
{%- if active_collection == blank or active_collection.products_count == 0 -%}
  {%- assign active_collection = collections['all-products'] -%}
{%- endif -%}
{%- if active_collection == blank or active_collection.products_count == 0 -%}
  {%- assign active_collection = collections['all'] -%}
{%- endif -%}
{%- if active_collection == blank or active_collection.products_count == 0 -%}
  {%- assign active_collection = collections['productivity-guides'] -%}
{%- endif -%}
{%- if active_collection == blank or active_collection.products_count == 0 -%}
  {%- assign active_collection = collections.first -%}
{%- endif -%}

<!-- Sticky Top Progress Bar -->
<div class="bundle-progress-bar js-bundle-progress-bar">
  <div class="container">
    <div class="progress-flex">
      <div class="progress-text js-progress-text">0/6 Selected</div>
      <div class="progress-track-wrapper">
        <div class="progress-track">
          <div class="progress-fill js-progress-fill"></div>
        </div>
        <div class="progress-indicators">
          {% for i in (1..6) %}
            <div class="progress-dot js-progress-dot" data-step="{{ i }}"></div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Product Selection Grid -->
<div class="bundle-grid js-bundle-grid">
  {% if active_collection != blank and active_collection.products.size > 0 %}
    {% for product in active_collection.products %}
      {% assign variant = product.selected_or_first_available_variant | default: product.variants.first %}
      {% if variant.id %}
      <!-- Guide Selection Card -->
      <div class="pattern-card glass-panel js-pattern-card" 
           data-product-id="{{ product.id }}" 
           data-variant-id="{{ variant.id }}" 
           data-title="{{ product.title | escape }}">
        
        <!-- Checkbox Overlay -->
        <div class="selection-overlay">
          <div class="select-checkbox">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
        </div>

        <!-- Product Image -->
        <div class="card-image-wrapper">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}" 
                 alt="{{ product.title | escape }}" 
                 class="card-image"
                 loading="lazy">
          {% else %}
            <!-- Placeholder -->
            <div class="card-image" style="background: linear-gradient(135deg, #FAEDCD 0%, #FAF6F0 100%); display: flex; align-items: center; justify-content: center; height: 100%;">
              <span style="color: var(--text-muted); font-size: 0.85rem; font-weight: 500;">No Image</span>
            </div>
          {% endif %}
        </div>

        <!-- Info Details -->
        <div class="card-info">
          <span class="badge badge-pdf card-badge">Instant PDF Download</span>
          <h3 class="card-title">{{ product.title }}</h3>
          
          <!-- Metadata footer of card -->
          <div class="card-meta">
            <span class="card-price">{{ product.price | money }}</span>
            <span class="btn btn-outline card-select-status" style="padding: 6px 16px; font-size: 0.85rem; pointer-events: none;">Select</span>
          </div>
        </div>
      </div>
      {% endif %}
    {% endfor %}
  {% else %}
    <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: var(--gradient-card); border-radius: var(--radius-md); border: 1px solid var(--glass-border);">
      <h3 style="margin-bottom: 12px; color: var(--text-color);">No guides available</h3>
      <p style="color: var(--text-muted);">Please add products to your collection in Shopify Admin to display them in the bundle builder.</p>
    </div>
  {% endif %}
</div>

<!-- Sticky Bottom Checkout CTA drawer -->
<div class="bundle-checkout-bar js-bundle-checkout-bar">
  <div class="container">
    <div class="checkout-bar-flex">
      <div class="checkout-bar-info">
        <div class="checkout-bar-title">Custom 6-Guide Productivity Bundle</div>
        <div class="checkout-bar-subtitle">
          Selected: <span class="js-selected-count">0</span> / 6 items — <strong>{{ bundle_price | default: "$29.00" }}</strong> 
          <span style="text-decoration: line-through; opacity: 0.6; margin-left: 6px; font-weight: 400;">$174.00 Value</span>
        </div>
      </div>
      <div class="checkout-bar-action">
        <button class="btn btn-primary checkout-btn js-checkout-btn" disabled>
          Choose 6 guides
        </button>
      </div>
    </div>
  </div>
</div>
