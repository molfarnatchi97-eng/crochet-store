{% comment %}
  Cart Template
  Renders the shopping cart page with items, summary, and checkout button.
  Resolves 404 errors when redirected to /cart after standard form submissions.
{% endcomment %}

<div class="cart-page-section" style="padding: 60px 0 100px;">
  <div class="container" style="max-width: 900px; margin: 0 auto; padding: 0 20px;">
    <h1 style="font-size: var(--font-h1, 2.25rem); font-weight: 800; margin-bottom: 32px; text-align: center; color: var(--text-color);">Your Cart</h1>
    
    {% if cart.item_count > 0 %}
      <form action="/cart" method="post" novalidate class="cart-form glass-panel" style="padding: 32px; border-radius: var(--radius-lg, 16px); background: var(--gradient-card); border: 1px solid var(--glass-border);">
        <div class="cart-items" style="display: flex; flex-direction: column; gap: 24px;">
          {% for item in cart.items %}
            <div class="cart-item" style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 20px; border-bottom: 1px solid var(--glass-border); gap: 16px; flex-wrap: wrap;">
              <div style="display: flex; align-items: center; gap: 16px;">
                {% if item.image %}
                  <img src="{{ item.image | img_url: '120x120', crop: 'center' }}" alt="{{ item.title | escape }}" style="width: 70px; height: 70px; border-radius: var(--radius-sm, 8px); object-fit: cover;">
                {% endif %}
                <div>
                  <h3 style="font-size: 1.05rem; font-weight: 600; margin-bottom: 4px; color: var(--text-color);">{{ item.product.title }}</h3>
                  {% unless item.product.has_only_default_variant %}
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">{{ item.variant.title }}</p>
                  {% endunless %}
                  <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="color: #d32f2f; font-size: 0.85rem; text-decoration: none; display: inline-block; margin-top: 6px;">Remove</a>
                </div>
              </div>
              <div style="text-align: right;">
                <span style="font-weight: 700; font-size: 1.15rem; color: var(--text-color);">{{ item.final_line_price | money }}</span>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="cart-footer" style="margin-top: 32px; display: flex; flex-direction: column; align-items: flex-end; gap: 16px;">
          <div style="font-size: 1.25rem; font-weight: 700; color: var(--text-color);">
            Subtotal: <span>{{ cart.total_price | money }}</span>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Taxes and shipping calculated at checkout</p>
          <div style="display: flex; gap: 16px; margin-top: 8px; flex-wrap: wrap;">
            <a href="/collections/all-products" class="btn btn-outline" style="padding: 12px 24px; text-decoration: none;">Continue Shopping</a>
            <button type="submit" name="checkout" class="btn btn-primary" style="padding: 12px 32px; font-weight: 700; cursor: pointer;">Check Out</button>
          </div>
        </div>
      </form>
    {% else %}
      <div class="glass-panel" style="text-align: center; padding: 60px 20px; border-radius: var(--radius-lg, 16px); background: var(--gradient-card); border: 1px solid var(--glass-border);">
        <h2 style="margin-bottom: 12px; color: var(--text-color);">Your cart is currently empty</h2>
        <p style="color: var(--text-muted); margin-bottom: 24px;">Explore our digital productivity guides and bundles to get started.</p>
        <a href="/collections/all-products" class="btn btn-primary" style="text-decoration: none;">Browse Guides</a>
      </div>
    {% endif %}
  </div>
</div>
