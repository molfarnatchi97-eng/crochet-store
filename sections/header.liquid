{% comment %}
  Header section with transparent glassmorphism navigation bar.
  Connects to Shopify Navigation (Main Menu) dynamically with robust fallback.
{% endcomment %}

<header class="site-header js-site-header">
  <div class="container header-container">
    <!-- Logo -->
    <a href="/" class="logo-text">
      <svg class="logo-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
      </svg>
      {{ shop.name | default: "MindFlow" }}
    </a>

    <!-- Navigation Menu -->
    <nav>
      <ul class="nav-menu">
        {%- assign header_menu = linklists[section.settings.menu] | default: linklists['main-menu'] -%}
        {%- if header_menu != blank and header_menu.links.size > 0 -%}
          {%- for link in header_menu.links -%}
            <li>
              <a href="{{ link.url }}" class="nav-link{% if link.active %} active{% endif %}" {% if link.url contains 'build-a-bundle' %}style="color: var(--primary-accent); font-weight: 600;"{% endif %}>
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="/" class="nav-link">Home</a></li>
          <li><a href="/collections/all-products" class="nav-link">Guides</a></li>
          <li><a href="/pages/build-a-bundle" class="nav-link" style="color: var(--primary-accent); font-weight: 600;">Build a Bundle</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- Cart Actions -->
    <div class="header-actions">
      <a href="/cart" class="cart-icon-wrapper" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span class="cart-count js-header-cart-count">0</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
