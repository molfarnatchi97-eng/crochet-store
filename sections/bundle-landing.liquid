{% comment %}
  Pre-made Curated Bundle Landing Page
{% endcomment %}

<div class="bundle-landing-wrapper">
  <!-- Hero Section -->
  <section class="landing-hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-badge-group">
            <span class="badge badge-pdf">Digital PDF Download</span>
            <span class="badge badge-discount">Save {{ section.settings.savings_percentage | default: "80%" }}</span>
          </div>
          
          <h1 class="hero-title">{{ section.settings.title | default: "The Ultimate Cozy Winter Crochet Pattern Bundle" }}</h1>
          
          <div class="hero-price-comparison">
            <span class="price-actual">{{ section.settings.actual_price | default: "$29" }}</span>
            <span class="price-compare">{{ section.settings.compare_at_price | default: "$150" }}</span>
            <span class="price-savings">You Save {{ section.settings.savings_amount | default: "$121" }}!</span>
          </div>

          <p class="hero-description">
            {{ section.settings.description | default: "Get instant access to 10 of our most-loved premium crochet patterns. Perfect for creating gorgeous blankets, cozy sweaters, and adorable plushies. Clear instructions, step-by-step photos, and print-ready files included." }}
          </p>

          <div class="hero-cta-group">
            {%- form 'product', product, id: 'bundle-checkout-form' -%}
              <input type="hidden" name="id" value="{{ section.settings.bundle_product.selected_or_first_available_variant.id | default: 12345678 }}">
              <button type="submit" class="btn btn-primary btn-large hero-buy-btn">
                Get the Bundle - {{ section.settings.actual_price | default: "$29" }}
              </button>
            {%- endform -%}
          </div>
        </div>

        <div class="hero-image-wrapper glass-panel">
          {% if section.settings.hero_image %}
            <img src="{{ section.settings.hero_image | img_url: '800x600', crop: 'center' }}" 
                 alt="{{ section.settings.title | escape }}">
          {% else %}
            <!-- Mock beautiful main bundle graphic -->
            <div style="background: linear-gradient(135deg, #FAEDCD 0%, #E8EAE6 100%); height: 350px; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: var(--radius-md);">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--primary-accent); margin-bottom: 16px;">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                <line x1="12" y1="22.08" x2="12" y2="12"/>
              </svg>
              <span style="font-weight: 700; font-size: 1.25rem; color: var(--text-color); margin-bottom: 4px;">Ultimate Bundle Package</span>
              <span style="color: var(--text-muted); font-size: 0.95rem;">10 Premium PDFs Included</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges Section -->
  <section class="trust-badges-section">
    <div class="container">
      <div class="trust-grid">
        <!-- Badge 1 -->
        <div class="trust-badge-card">
          <div class="trust-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
            </svg>
          </div>
          <div class="trust-title">Instant Delivery</div>
          <div class="trust-desc">Files delivered instantly via email and on the confirmation screen.</div>
        </div>

        <!-- Badge 2 -->
        <div class="trust-badge-card">
          <div class="trust-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <div class="trust-title">Secure Checkout</div>
          <div class="trust-desc">Fully encrypted checkout processed by Shopify Payments.</div>
        </div>

        <!-- Badge 3 -->
        <div class="trust-badge-card">
          <div class="trust-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div class="trust-title">Lifetime Access</div>
          <div class="trust-desc">Redownload your patterns anytime, including any future pattern updates.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Breakdown Section -->
  <section class="breakdown-section">
    <div class="container">
      <div class="section-header">
        <h2>What's Included in This Bundle</h2>
        <p style="color: var(--text-muted);">Each pattern includes detailed step-by-step instructions, standard US terms, and full support.</p>
      </div>

      <div class="breakdown-grid">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="breakdown-item" {{ block.shopify_attributes }}>
              <div class="breakdown-item-img">
                {% if block.settings.item_image %}
                  <img src="{{ block.settings.item_image | img_url: '400x300', crop: 'center' }}" 
                       alt="{{ block.settings.title | escape }}"
                       loading="lazy">
                {% else %}
                  <div style="background: linear-gradient(135deg, #E8EAE6 0%, #FAF6F0 100%); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-weight: 600; color: var(--text-muted);">
                    Pattern Preview
                  </div>
                {% endif %}
              </div>
              <div class="breakdown-item-info">
                <span class="badge badge-pdf" style="align-self: flex-start;">PDF Pattern Included</span>
                <div class="breakdown-item-title">{{ block.settings.title | default: "Premium Pattern Design" }}</div>
                <div class="breakdown-item-desc">{{ block.settings.description | default: "Step-by-step instructions with sizing details, recommended yarns, and helper stitch graphs." }}</div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <!-- Mocking Bundle Contents -->
          {% for i in (1..6) %}
            <div class="breakdown-item">
              <div class="breakdown-item-img">
                <div style="background: linear-gradient(135deg, #E8EAE6 0%, #FAEDCD 100%); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-weight: 600; color: var(--text-muted);">
                  Pattern #{{ i }}
                </div>
              </div>
              <div class="breakdown-item-info">
                <span class="badge badge-pdf" style="align-self: flex-start;">PDF Pattern Included</span>
                <div class="breakdown-item-title">Cozy Crochet Design Pattern #{{ i }}</div>
                <div class="breakdown-item-desc">Highly detailed step-by-step pattern guide containing digital diagrams, yarn color recommendations, and video tutorial access codes.</div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Bundle Landing",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Bundle Title",
      "default": "The Ultimate Cozy Winter Crochet Pattern Bundle"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Bundle Description"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Bundle Image"
    },
    {
      "type": "text",
      "id": "actual_price",
      "label": "Actual Price",
      "default": "$29"
    },
    {
      "type": "text",
      "id": "compare_at_price",
      "label": "Compare At Price (Value)",
      "default": "$150"
    },
    {
      "type": "text",
      "id": "savings_amount",
      "label": "Savings Amount ($)",
      "default": "$121"
    },
    {
      "type": "text",
      "id": "savings_percentage",
      "label": "Savings Percentage (%)",
      "default": "80%"
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Shopify Bundle Product"
    }
  ],
  "blocks": [
    {
      "type": "bundle_item",
      "name": "Bundle Content Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Pattern Title",
          "default": "Premium Pattern Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Pattern Description"
        },
        {
          "type": "image_picker",
          "id": "item_image",
          "label": "Pattern Image"
        }
      ]
    }
  ]
}
{% endschema %}
