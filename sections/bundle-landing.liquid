{% comment %}
  Pre-made Curated Bundle Landing Page
{% endcomment %}

{%- assign bundle_collection = section.settings.collection -%}
{%- if bundle_collection != blank and bundle_collection.products == blank -%}
  {%- assign bundle_collection = collections[section.settings.collection] -%}
{%- endif -%}
{%- if bundle_collection == blank or bundle_collection.products_count == 0 -%}
  {%- assign bundle_collection = collections['all-products'] -%}
{%- endif -%}
{%- if bundle_collection == blank or bundle_collection.products_count == 0 -%}
  {%- assign bundle_collection = collections['all'] -%}
{%- endif -%}
{%- if bundle_collection == blank or bundle_collection.products_count == 0 -%}
  {%- assign bundle_collection = collections['productivity-guides'] -%}
{%- endif -%}
{%- if bundle_collection == blank or bundle_collection.products_count == 0 -%}
  {%- assign bundle_collection = collections.first -%}
{%- endif -%}

{%- assign bundle_prod = section.settings.bundle_product -%}
{%- if bundle_prod != blank and bundle_prod.title == blank -%}
  {%- assign bundle_prod = all_products[section.settings.bundle_product] -%}
{%- endif -%}
{%- if bundle_prod == blank and product != blank -%}
  {%- assign bundle_prod = product -%}
{%- endif -%}
{%- if bundle_prod == blank and bundle_collection != blank and bundle_collection.products.size > 0 -%}
  {%- assign bundle_prod = bundle_collection.products.first -%}
{%- endif -%}
{%- if bundle_prod == blank and collections.all.products.size > 0 -%}
  {%- assign bundle_prod = collections.all.products.first -%}
{%- endif -%}

<div class="bundle-landing-wrapper">
  <!-- Hero Section -->
  <section class="landing-hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-badge-group">
            <span class="badge badge-pdf">Digital PDF Guide Download</span>
            <span class="badge badge-discount">Save {{ section.settings.savings_percentage | default: "80%" }}</span>
          </div>
          
          <h1 class="hero-title">{{ section.settings.title | default: "The Ultimate Self-Improvement & Mental Productivity Bundle" }}</h1>
          
          <div class="hero-price-comparison">
            <span class="price-actual">{{ section.settings.actual_price | default: "$29" }}</span>
            <span class="price-compare">{{ section.settings.compare_at_price | default: "$150" }}</span>
            <span class="price-savings">You Save {{ section.settings.savings_amount | default: "$121" }}!</span>
          </div>

          <p class="hero-description">
            {{ section.settings.description | default: "Get instant access to 10 of our best-selling mental productivity guides and growth frameworks. Perfect for mastering daily focus, building unbreakable habits, and organizing your mental workflow. Actionable worksheets, printable planners, and comprehensive digital guides included." }}
          </p>

          <div class="hero-cta-group">
            {%- if template.name != 'index' and bundle_prod != blank and bundle_prod.title != blank -%}
              {%- assign bundle_variant = bundle_prod.selected_or_first_available_variant | default: bundle_prod.variants.first -%}
              {%- form 'product', bundle_prod, id: 'bundle-checkout-form' -%}
                <input type="hidden" name="id" value="{{ bundle_variant.id }}">
                <button type="submit" class="btn btn-primary btn-large hero-buy-btn" {% unless bundle_variant.available %}disabled{% endunless %}>
                  Get the Bundle - {{ section.settings.actual_price | default: "$29" }}
                </button>
              {%- endform -%}
            {%- else -%}
              <a href="{{ section.settings.bundle_page_url | default: '/pages/build-a-bundle' }}" class="btn btn-primary btn-large hero-buy-btn">
                Build Your Bundle - {{ section.settings.actual_price | default: "$29" }}
              </a>
            {%- endif -%}
          </div>
        </div>

        <div class="hero-image-wrapper glass-panel">
          {% if section.settings.hero_image %}
            <img src="{{ section.settings.hero_image | img_url: '800x600', crop: 'center' }}" 
                 alt="{{ section.settings.title | escape }}">
          {% else %}
            <!-- Mock beautiful main bundle graphic -->
            <div style="background: linear-gradient(135deg, #FAEDCD 0%, #E8EAE6 100%); height: 350px; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: var(--radius-md);">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--primary-accent); margin-bottom: 16px;">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                <line x1="12" y1="22.08" x2="12" y2="12"/>
              </svg>
              <span style="font-weight: 700; font-size: 1.25rem; color: var(--text-color); margin-bottom: 4px;">Ultimate Bundle Package</span>
              <span style="color: var(--text-muted); font-size: 0.95rem;">10 Premium Guides Included</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <!-- Breakdown Section -->
  <section class="breakdown-section">
    <div class="container">
      <div class="section-header">
        <h2>{{ section.settings.included_title | default: "What's Included in This Bundle" }}</h2>
        <p style="color: var(--text-muted);">{{ section.settings.included_description | default: "Each guide includes actionable step-by-step frameworks, printable worksheets, and lifetime digital updates." }}</p>
      </div>

      <div class="breakdown-grid">
        {%- assign included_limit = section.settings.included_products_limit | default: 6 -%}
        {% if bundle_collection != blank and bundle_collection.products.size > 0 %}
          {% for product in bundle_collection.products limit: included_limit %}
            <a href="{{ product.url }}" class="breakdown-item" style="text-decoration: none; color: inherit;">
              <div class="breakdown-item-img">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '600x450', crop: 'center' }}" 
                       alt="{{ product.title | escape }}" 
                       loading="lazy">
                {% else %}
                  <div style="background: linear-gradient(135deg, #E8EAE6 0%, #FAF6F0 100%); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-weight: 600; color: var(--text-muted);">
                    {{ product.title | escape }}
                  </div>
                {% endif %}
              </div>
              <div class="breakdown-item-info">
                <span class="badge badge-pdf" style="align-self: flex-start;">Instant PDF Download</span>
                <div class="breakdown-item-title">{{ product.title }}</div>
                {% if product.description != blank %}
                  <div class="breakdown-item-desc">{{ product.description | strip_html | truncate: 130 }}</div>
                {% endif %}
                <div class="breakdown-item-price" style="font-weight: 700; color: var(--text-color); margin-top: auto; padding-top: 8px;">
                  {{ product.price | money }}
                </div>
              </div>
            </a>
          {% endfor %}

          {% if template.name == 'index' or section.settings.show_bundle_card %}
            <!-- Bundle Upsell Card (Reference: demo-product.html) -->
            {%- assign bundle_target_url = section.settings.bundle_page_url | default: '/pages/build-a-bundle' -%}
            <a href="{{ bundle_target_url }}" class="breakdown-item bundle-upsell-card" style="text-decoration: none; color: inherit; cursor: pointer; background: linear-gradient(135deg, #FAEDCD 0%, #E8EAE6 100%); border: 2px solid var(--primary-accent); display: flex; flex-direction: column;">
              <div class="breakdown-item-img" style="background: rgba(255,255,255,0.4); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--primary-accent); margin-bottom: 8px;">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                  <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
                <span style="font-weight: 700; font-size: 1rem; color: var(--text-color);">Build a 6-Guide Bundle</span>
              </div>
              <div class="breakdown-item-info" style="display: flex; flex-direction: column; flex-grow: 1;">
                <span class="badge" style="background: var(--primary-light); color: var(--primary-dark); align-self: flex-start;">Save Over {{ section.settings.savings_percentage | default: "80%" }}</span>
                <div class="breakdown-item-title">Custom 6-Guide Bundle</div>
                <div class="breakdown-item-desc">Curate your personalized bundle of 6 guides for one low price. Instant digital PDF delivery.</div>
                <div class="card-meta" style="display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 12px; border-top: 1px solid rgba(43,37,32,0.08);">
                  <span class="card-price" style="font-weight: 700; font-size: 1.15rem; color: var(--primary-dark);">{{ section.settings.actual_price | default: "$29.00" }}</span>
                  <span class="btn btn-primary" style="padding: 8px 18px; font-size: 0.85rem;">Build It</span>
                </div>
              </div>
            </a>
          {% endif %}
        {% elsif section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="breakdown-item" {{ block.shopify_attributes }}>
              <div class="breakdown-item-img">
                {% if block.settings.item_image %}
                  <img src="{{ block.settings.item_image | img_url: '400x300', crop: 'center' }}" 
                       alt="{{ block.settings.title | escape }}" 
                       loading="lazy">
                {% else %}
                  <div style="background: linear-gradient(135deg, #E8EAE6 0%, #FAF6F0 100%); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-weight: 600; color: var(--text-muted);">
                    Guide Preview
                  </div>
                {% endif %}
              </div>
              <div class="breakdown-item-info">
                <span class="badge badge-pdf" style="align-self: flex-start;">Instant PDF Download</span>
                <div class="breakdown-item-title">{{ block.settings.title | default: "Premium Productivity Guide" }}</div>
                <div class="breakdown-item-desc">{{ block.settings.description | default: "Step-by-step frameworks with printable habit trackers, productivity templates, and implementation guides." }}</div>
              </div>
            </div>
          {% endfor %}

          {% if template.name == 'index' or section.settings.show_bundle_card %}
            <!-- Bundle Upsell Card (Reference: demo-product.html) -->
            {%- assign bundle_target_url = section.settings.bundle_page_url | default: '/pages/build-a-bundle' -%}
            <a href="{{ bundle_target_url }}" class="breakdown-item bundle-upsell-card" style="text-decoration: none; color: inherit; cursor: pointer; background: linear-gradient(135deg, #FAEDCD 0%, #E8EAE6 100%); border: 2px solid var(--primary-accent); display: flex; flex-direction: column;">
              <div class="breakdown-item-img" style="background: rgba(255,255,255,0.4); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--primary-accent); margin-bottom: 8px;">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                  <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
                <span style="font-weight: 700; font-size: 1rem; color: var(--text-color);">Build a 6-Guide Bundle</span>
              </div>
              <div class="breakdown-item-info" style="display: flex; flex-direction: column; flex-grow: 1;">
                <span class="badge" style="background: var(--primary-light); color: var(--primary-dark); align-self: flex-start;">Save Over {{ section.settings.savings_percentage | default: "80%" }}</span>
                <div class="breakdown-item-title">Custom 6-Guide Bundle</div>
                <div class="breakdown-item-desc">Curate your personalized bundle of 6 guides for one low price. Instant digital PDF delivery.</div>
                <div class="card-meta" style="display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 12px; border-top: 1px solid rgba(43,37,32,0.08);">
                  <span class="card-price" style="font-weight: 700; font-size: 1.15rem; color: var(--primary-dark);">{{ section.settings.actual_price | default: "$29.00" }}</span>
                  <span class="btn btn-primary" style="padding: 8px 18px; font-size: 0.85rem;">Build It</span>
                </div>
              </div>
            </a>
          {% endif %}
        {% else %}
          <div style="grid-column: 1 / -1; text-align: center; padding: 48px 20px; background: white; border-radius: var(--radius-md); border: 1px solid rgba(43,37,32,0.06);">
            <p style="color: var(--text-muted);">No products found in this collection. Please select a collection in the theme editor.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- Trust Badges Section -->
  <section class="trust-badges-section">
    <div class="container">
      <div class="trust-grid">
        <!-- Badge 1 -->
        <div class="trust-badge-card">
          <div class="trust-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
            </svg>
          </div>
          <div class="trust-title">Instant Delivery</div>
          <div class="trust-desc">Files delivered instantly via email and on the confirmation screen.</div>
        </div>

        <!-- Badge 2 -->
        <div class="trust-badge-card">
          <div class="trust-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <div class="trust-title">Secure Checkout</div>
          <div class="trust-desc">Fully encrypted checkout processed by Shopify Payments.</div>
        </div>

        <!-- Badge 3 -->
        <div class="trust-badge-card">
          <div class="trust-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div class="trust-title">Lifetime Access</div>
          <div class="trust-desc">Redownload your guides anytime, including any future guide updates.</div>
        </div>
      </div>
    </div>
  </section>

  {% unless template.name == 'index' %}
    {% if section.settings.show_builder_system %}
      <!-- Build Your 6-Guide Bundle Section (Only on dedicated bundle landing page, NOT on Home Page) -->
      <section class="build-bundle-section" id="build-bundle-section" style="padding: 80px 0 120px; border-top: 1px solid rgba(43, 37, 32, 0.08);">
        <div class="container">
          <div class="section-header">
            <h2>{{ section.settings.builder_title | default: "Build Your 6-Guide Bundle" }}</h2>
            <p style="color: var(--text-muted); font-size: 1.05rem;">
              {{ section.settings.builder_description | default: "Select exactly 6 guides below to customize your bundle for just $29.00." }}
            </p>
          </div>

          {% render 'build-a-bundle', bundle_collection: bundle_collection, bundle_price: section.settings.actual_price %}
        </div>
      </section>
    {% endif %}
  {% endunless %}
</div>

{% schema %}
{
  "name": "Bundle Landing",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Bundle Title",
      "default": "The Ultimate Self-Improvement & Mental Productivity Bundle"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Bundle Description"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Bundle Image"
    },
    {
      "type": "text",
      "id": "actual_price",
      "label": "Actual Price",
      "default": "$29"
    },
    {
      "type": "text",
      "id": "compare_at_price",
      "label": "Compare At Price (Value)",
      "default": "$150"
    },
    {
      "type": "text",
      "id": "savings_amount",
      "label": "Savings Amount ($)",
      "default": "$121"
    },
    {
      "type": "text",
      "id": "savings_percentage",
      "label": "Savings Percentage (%)",
      "default": "80%"
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Shopify Bundle Product"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Bundle Products Collection"
    },
    {
      "type": "range",
      "id": "included_products_limit",
      "min": 4,
      "max": 24,
      "step": 1,
      "label": "Products to display in Breakdown",
      "default": 6
    },
    {
      "type": "text",
      "id": "included_title",
      "label": "Breakdown Section Heading",
      "default": "What's Included in This Bundle"
    },
    {
      "type": "textarea",
      "id": "included_description",
      "label": "Breakdown Section Subtitle",
      "default": "Each guide includes actionable step-by-step frameworks, printable worksheets, and lifetime digital updates."
    },
    {
      "type": "text",
      "id": "builder_title",
      "label": "Bundle Builder Heading",
      "default": "Build Your 6-Guide Bundle"
    },
    {
      "type": "textarea",
      "id": "builder_description",
      "label": "Bundle Builder Subtitle",
      "default": "Select exactly 6 guides below to customize your bundle for just $29.00."
    },
    {
      "type": "checkbox",
      "id": "show_bundle_card",
      "label": "Show Bundle Upsell Card in Products Grid",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_builder_system",
      "label": "Show Full 6-Guide Selection System",
      "default": true,
      "info": "Automatically hidden on the Home Page to keep it clean and direct customers to the dedicated Build-a-Bundle page."
    },
    {
      "type": "url",
      "id": "bundle_page_url",
      "label": "Dedicated Build-a-Bundle Page URL",
      "info": "Leave blank to default to /pages/build-a-bundle"
    }
  ],
  "blocks": [
    {
      "type": "bundle_item",
      "name": "Bundle Content Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Guide Title",
          "default": "Premium Productivity Guide"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Guide Description"
        },
        {
          "type": "image_picker",
          "id": "item_image",
          "label": "Guide Image"
        }
      ]
    }
  ]
}
{% endschema %}
