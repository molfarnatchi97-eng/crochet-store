{% comment %}
  Standard styled footer.
  Connects to Shopify Navigation menus with clean fallbacks.
{% endcomment %}

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Logo / Info Column -->
      <div class="footer-col" style="max-width: 320px;">
        <span class="logo-text" style="font-size: 1.4rem;">
          <svg class="logo-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
          {{ shop.name | default: "MindFlow" }}
        </span>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 8px;">
          Premium digital productivity guides and growth planners designed for peak performance, mental clarity, and daily habit mastery.
        </p>
      </div>

      <!-- Links Column -->
      <div class="footer-col">
        <div class="footer-col-title">Shop Guides</div>
        <ul class="footer-links">
          {%- assign footer_menu = linklists[section.settings.footer_menu] | default: linklists['footer'] -%}
          {%- if footer_menu != blank and footer_menu.links.size > 0 -%}
            {%- for link in footer_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/collections/all-products">All Products</a></li>
            <li><a href="/pages/build-a-bundle">Build-a-Bundle</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Support Column -->
      <div class="footer-col">
        <div class="footer-col-title">Customer Service</div>
        <ul class="footer-links">
          {%- assign support_menu = linklists[section.settings.support_menu] | default: linklists['customer-service'] -%}
          {%- if support_menu != blank and support_menu.links.size > 0 -%}
            {%- for link in support_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/contact">Contact Support</a></li>
            <li><a href="/policies/terms-of-service">Terms of Service</a></li>
            <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright / Socials -->
    <div class="footer-bottom">
      <div class="copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "MindFlow" }}. All digital guides and planners are for personal use.
      </div>
      <div class="payment-badges" style="display: flex; gap: 8px; opacity: 0.65;">
        <!-- Simple text-based trust badges -->
        <span style="font-size: 0.75rem; border: 1px solid var(--text-muted); padding: 2px 6px; border-radius: 4px;">Shopify Secure</span>
        <span style="font-size: 0.75rem; border: 1px solid var(--text-muted); padding: 2px 6px; border-radius: 4px;">PayPal</span>
        <span style="font-size: 0.75rem; border: 1px solid var(--text-muted); padding: 2px 6px; border-radius: 4px;">Stripe</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Shop Menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "support_menu",
      "label": "Customer Service Menu"
    }
  ]
}
{% endschema %}
